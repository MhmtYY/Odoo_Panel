[Unit]
Description=Odoo Yönetim Paneli otomatik yedek turu (zamanı gelen ortamların yedeği; çalışan ajana istek gönderir)
After=odoo-panel-ajan.service
Requires=odoo-panel-ajan.service

[Service]
Type=oneshot
WorkingDirectory=/opt/odoo-panel/kod
EnvironmentFile=/opt/odoo-panel/ayar/ajan.env
ExecStart=/usr/bin/python3 -m ajan otomatik-yedek
