[Unit]
Description=Odoo Yönetim Paneli ajanı (panel.vekosis.com için Docker, PostgreSQL ve git işleri)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/odoo-panel/kod
EnvironmentFile=/opt/odoo-panel/ayar/ajan.env
ExecStart=/usr/bin/python3 -m ajan
Restart=on-failure
RestartSec=5
# Odoo konteyneri kodu, ek modülleri ve odoo.conf'u okuyabilmeli; gizli dosyalar kodda ayrıca 600/700 yapılır
UMask=0022

[Install]
WantedBy=multi-user.target
